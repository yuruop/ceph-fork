{
    "name": "Ceph-Build-Env",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "CCACHE_DIR": "/workspaces/ceph-fork/.ccache"
    },
    "runArgs": [
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "llvm-vs-code-extensions.vscode-clangd"
            ]
        }
    }
}